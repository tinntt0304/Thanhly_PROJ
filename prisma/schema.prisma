// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Trạng thái do người bán chốt thủ công. Trạng thái "đã kết thúc chờ liên hệ" /
// "chưa bán" (hết giờ, không ai trả giá) được SUY RA từ endTime + bids tại
// thời điểm đọc dữ liệu, không lưu trực tiếp — tránh cần cron job nào chạy nền.
enum ProductStatus {
  ACTIVE // đang mở đấu giá (hoặc đã hết giờ, chờ người bán xử lý)
  SOLD // người bán đã đánh dấu giao dịch hoàn tất
  CANCELLED // người bán huỷ (vd. người thắng bùng kèo, hàng lỗi phát sinh...)
}

// SUPERADMIN: vận hành sàn — quản lý menu điều hướng, thông báo & tin tức, trang "Về
// chúng tôi". SELLER: người bán tự đăng ký tài khoản để đăng sản phẩm đấu giá của mình
// (P0 ban đầu chỉ có 1 tài khoản superadmin duy nhất qua seed; SELLER tự đăng ký công
// khai ở /admin/register).
enum UserRole {
  SUPERADMIN
  SELLER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         UserRole @default(SELLER)

  createdAt DateTime @default(now())

  products Product[]
}

model Product {
  id String @id @default(cuid())

  seller   User?   @relation(fields: [sellerId], references: [id])
  sellerId String? // null = sản phẩm cũ trước khi có hệ thống nhiều người bán (đã backfill về superadmin lúc migrate)

  title       String
  description String
  condition   String // "Mới", "Đã dùng - còn tốt", "Lỗi nhẹ: ...", v.v. (free text)
  images      String[] // URL ảnh (Supabase Storage), tối thiểu 1 ảnh bắt buộc ở tầng ứng dụng
  attributes  Json     @default("[]") // thuộc tính sản phẩm: [{ name: string, value: string }]
  tags        String[] @default([]) // nhãn hiển thị: "FEATURED" | "HOT_DEAL" (whitelist ở src/lib/tags.ts)

  quantity Int @default(1) // số lượng người bán muốn bán

  startPrice   Int // giá khởi điểm (VNĐ)
  minBidStep   Int // bước giá tối thiểu (VNĐ)
  currentPrice Int // giá hiện tại = startPrice ban đầu, cập nhật theo lượt trả giá cao nhất
  buyNowPrice  Int? // P1.1 - giá mua ngay, optional

  endTime DateTime // thời điểm kết thúc phiên đấu giá

  status ProductStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bids Bid[]

  @@index([status, endTime])
}

model Bid {
  id String @id @default(cuid())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  phone  String // SĐT người trả giá; ẩn một phần khi hiển thị công khai
  amount Int

  createdAt DateTime @default(now())

  @@index([productId, amount])
}

// Singleton: nội dung "bằng chứng uy tín" hiển thị đầu trang chủ (P0.5).
// Chỉ nên có duy nhất 1 dòng trong bảng này.
model TrustProfile {
  id String @id @default(cuid())

  avgRating Float // vd. 4.8
  soldCount Int // số đơn đã bán từ sàn cũ
  reviews   Json // mảng { author: string; text: string; imageUrl?: string }[]

  updatedAt DateTime @updatedAt
}

enum ChatSessionStatus {
  OPEN
  CLOSED
}

enum ChatSender {
  VISITOR
  ADMIN
}

// Phiên chat giữa 1 khách (không cần tài khoản, định danh bằng id ngẫu nhiên lưu ở
// localStorage — coi như "vé" ra vào, giống tinh thần không-tài-khoản của cả trang)
// với người bán. Không có bảng User cho khách nên visitorName/visitorPhone lưu trực
// tiếp ở đây.
model ChatSession {
  id String @id @default(cuid())

  visitorName  String
  visitorPhone String

  status ChatSessionStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // cập nhật mỗi khi có tin nhắn mới — dùng để sắp xếp danh sách chat ở admin

  messages ChatMessage[]

  @@index([updatedAt])
}

model ChatMessage {
  id String @id @default(cuid())

  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String

  sender  ChatSender
  content String

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}

// Cấu trúc menu điều hướng công khai (ngoài "Trang chủ" luôn cố định đứng đầu, không
// lưu ở đây) — do superadmin quản lý ở /admin/danh-muc, hiển thị theo `order` tăng dần.
model NavItem {
  id    String @id @default(cuid())
  label String
  href  String
  order Int    @default(0)

  createdAt DateTime @default(now())
}

// Nội dung dạng singleton theo key (vd. "about_us" cho trang "Về chúng tôi") — do
// superadmin chỉnh sửa ở /admin/danh-muc.
model SiteContent {
  key       String   @id
  content   String
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        String  @id @default(cuid())
  title     String
  content   String
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
}
