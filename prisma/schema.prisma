// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Trạng thái do người bán chốt thủ công. Trạng thái "đã kết thúc chờ liên hệ" /
// "chưa bán" (hết giờ, không ai trả giá) được SUY RA từ endTime + bids tại
// thời điểm đọc dữ liệu, không lưu trực tiếp — tránh cần cron job nào chạy nền.
enum ProductStatus {
  ACTIVE // đang mở đấu giá (hoặc đã hết giờ, chờ người bán xử lý)
  SOLD // người bán đã đánh dấu giao dịch hoàn tất
  CANCELLED // người bán huỷ (vd. người thắng bùng kèo, hàng lỗi phát sinh...)
}

// SUPERADMIN: vận hành sàn — quản lý menu điều hướng, thông báo & tin tức, trang "Về
// chúng tôi". SELLER: người bán tự đăng ký tài khoản để đăng sản phẩm đấu giá của mình
// (P0 ban đầu chỉ có 1 tài khoản superadmin duy nhất qua seed; SELLER tự đăng ký công
// khai ở /admin/register).
enum UserRole {
  SUPERADMIN
  SELLER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         UserRole @default(SELLER)

  // Bắt buộc xác minh email bằng OTP trước khi đăng nhập được (xem EmailOtp, verifyOtpAction
  // ở lib/actions/auth.ts) — chặn đăng ký bằng email rác/email người khác. Tài khoản có sẵn
  // trước khi thêm tính năng này được backfill true (migration 20260828..._add_email_otp),
  // chỉ tài khoản đăng ký MỚI mới bắt đầu ở false.
  emailVerified Boolean @default(false)

  creditBalance Int @default(0) // VNĐ — trừ khi tìm nhóm Facebook (chỉ gọi Apify thật), cộng khi nạp qua SePay

  // Mốc thời gian lượt gọi Apify thật gần nhất — dùng để chặn spam (chống DoS/tốn credit
  // Apify): 1 tài khoản chỉ được gọi API thật cách nhau tối thiểu SEARCH_RATE_LIMIT_SECONDS.
  lastSearchAt DateTime?

  createdAt DateTime @default(now())

  products              Product[]
  creditTransactions    CreditTransaction[]
  topUpRequests         TopUpRequest[]
  facebookGroups        FacebookGroup[]
  facebookKeywordSearch FacebookKeywordSearch[]
  orders                Order[]
  phoneReports          PhoneReport[]
  emailOtp              EmailOtp?
}

// 1 OTP đang hiệu lực/user (unique userId — tạo OTP mới thì ghi đè, không cộng dồn nhiều
// hàng). codeHash thay vì lưu thẳng mã: DB rò rỉ (backup lộ, truy vấn lỗi log ra...) không
// lộ luôn mã 6 số đang dùng được. attempts đếm số lần verify sai để khoá sau
// MAX_OTP_ATTEMPTS lần (chống dò 6 số bằng brute-force), reset về 0 mỗi lần gửi OTP mới.
model EmailOtp {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

model Product {
  id String @id @default(cuid())

  seller   User?   @relation(fields: [sellerId], references: [id])
  sellerId String? // null = sản phẩm cũ trước khi có hệ thống nhiều người bán (đã backfill về superadmin lúc migrate)

  title       String
  description String
  condition   String // "Mới", "Đã dùng - còn tốt", "Lỗi nhẹ: ...", v.v. (free text)
  images      String[] // URL ảnh (Supabase Storage), tối thiểu 1 ảnh bắt buộc ở tầng ứng dụng
  attributes  Json     @default("[]") // thuộc tính sản phẩm: [{ name: string, value: string }]
  tags        String[] @default([]) // nhãn hiển thị: "FEATURED" | "HOT_DEAL" (whitelist ở src/lib/tags.ts)

  quantity Int @default(1) // số lượng người bán muốn bán

  startPrice   Int // giá khởi điểm (VNĐ)
  minBidStep   Int // bước giá tối thiểu (VNĐ)
  currentPrice Int // giá hiện tại = startPrice ban đầu, cập nhật theo lượt trả giá cao nhất
  buyNowPrice  Int? // P1.1 - giá mua ngay, optional

  endTime DateTime // thời điểm kết thúc phiên đấu giá

  status ProductStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bids   Bid[]
  orders Order[]

  @@index([status, endTime])
}

enum OrderStatus {
  NEW // vừa tạo, chưa tạo vận đơn GHN
  SHIPPING // đã tạo vận đơn GHN, đang giao
  DELIVERED // GHN báo giao thành công
  CANCELLED // đã huỷ (đơn nội bộ hoặc đã huỷ vận đơn GHN)
}

// Đơn hàng tạo ra từ 1 sản phẩm đã "Đánh dấu đã bán" (xem product.tsx) — gắn với đơn vị
// vận chuyển GHN (Giao Hàng Nhanh) để tạo vận đơn thật + theo dõi trạng thái giao hàng.
// Không unique theo productId: 1 sản phẩm có thể tạo lại đơn (sửa sai) hoặc bán nhiều
// lượt (quantity > 1) nên cho phép nhiều Order/1 Product.
model Order {
  id String @id @default(cuid())

  seller   User   @relation(fields: [sellerId], references: [id])
  sellerId String

  product   Product @relation(fields: [productId], references: [id])
  productId String

  buyerName    String
  buyerPhone   String
  buyerAddress String // số nhà, tên đường... — phường/quận/tỉnh tách riêng bên dưới vì GHN yêu cầu mã, không nhận text tự do cho địa chỉ người nhận

  provinceId   Int
  provinceName String
  districtId   Int
  districtName String
  wardCode     String
  wardName     String

  codAmount  Int // tiền thu hộ khi giao (VNĐ) — 0 nếu người mua đã thanh toán trước
  weightGram Int     @default(500)
  lengthCm   Int     @default(20)
  widthCm    Int     @default(20)
  heightCm   Int     @default(10)
  note       String?

  shopPaysShipping Boolean @default(false) // false = người mua trả phí ship khi nhận hàng, true = shop tự trả

  status OrderStatus @default(NEW)

  ghnOrderCode       String? // mã vận đơn GHN — null tới khi bấm "Tạo vận đơn GHN"
  ghnStatus          String? // trạng thái thô GHN trả về (picking, delivering, delivered...), cập nhật khi bấm "Làm mới trạng thái"
  shippingFee        Int?
  expectedDeliveryAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId, status])
  @@index([productId])
  @@index([ghnOrderCode])
  @@index([ghnStatus]) // tab SHIPPING/RETURNING/ISSUE ở /admin/orders lọc theo ghnStatus IN (...)
  @@index([createdAt]) // tab list sắp xếp + lọc theo khoảng ngày tạo
}

model Bid {
  id String @id @default(cuid())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  phone  String // SĐT người trả giá; ẩn một phần khi hiển thị công khai
  amount Int

  createdAt DateTime @default(now())

  @@index([productId, amount])
}

// Singleton: nội dung "bằng chứng uy tín" hiển thị đầu trang chủ (P0.5).
// Chỉ nên có duy nhất 1 dòng trong bảng này.
model TrustProfile {
  id String @id @default(cuid())

  avgRating Float // vd. 4.8
  soldCount Int // số đơn đã bán từ sàn cũ
  reviews   Json // mảng { author: string; text: string; imageUrl?: string }[]

  updatedAt DateTime @updatedAt
}

enum ChatSessionStatus {
  OPEN
  CLOSED
}

enum ChatSender {
  VISITOR
  ADMIN
}

// Phiên chat giữa 1 khách (không cần tài khoản, định danh bằng id ngẫu nhiên lưu ở
// localStorage — coi như "vé" ra vào, giống tinh thần không-tài-khoản của cả trang)
// với người bán. Không có bảng User cho khách nên visitorName/visitorPhone lưu trực
// tiếp ở đây.
model ChatSession {
  id String @id @default(cuid())

  visitorName  String
  visitorPhone String

  status ChatSessionStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // cập nhật mỗi khi có tin nhắn mới — dùng để sắp xếp danh sách chat ở admin

  messages ChatMessage[]

  @@index([updatedAt])
}

model ChatMessage {
  id String @id @default(cuid())

  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String

  sender  ChatSender
  content String

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
}

// Cấu trúc menu điều hướng công khai (ngoài "Trang chủ" luôn cố định đứng đầu, không
// lưu ở đây) — do superadmin quản lý ở /admin/danh-muc, hiển thị theo `order` tăng dần.
model NavItem {
  id    String @id @default(cuid())
  label String
  href  String
  order Int    @default(0)

  createdAt DateTime @default(now())
}

// Nội dung dạng singleton theo key (vd. "about_us" cho trang "Về chúng tôi") — do
// superadmin chỉnh sửa ở /admin/danh-muc.
model SiteContent {
  key       String   @id
  content   String
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        String  @id @default(cuid())
  title     String
  content   String
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
}

// Lưu lại nhóm Facebook tìm được qua /admin/nhom-facebook — riêng theo từng tài khoản
// (nhóm của tài khoản nào chỉ tài khoản đó thấy), upsert theo (fbId, userId) nên cùng 1
// người tìm trùng nhiều lần không tạo bản ghi trùng, chỉ cập nhật lastSeenAt + gộp thêm
// từ khóa mới. 2 người khác nhau cùng tìm ra 1 nhóm Facebook thật thì mỗi người có 1
// bản ghi riêng (không chia sẻ giữa các tài khoản).
model FacebookGroup {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String

  fbId        String
  name        String
  url         String
  visibility  String?
  memberCount Int?
  postsPerDay Float?
  description String?
  keywords    String[] @default([])

  firstFoundAt DateTime @default(now())
  lastSeenAt   DateTime @updatedAt

  @@unique([fbId, userId])
  @@index([userId, lastSeenAt])
}

// Nhật ký mỗi từ khóa thực sự đã gọi Apify (không log từ khóa được phục vụ từ cache) —
// riêng theo từng tài khoản, dùng để tránh gọi lại Apify cho từ khóa CHÍNH tài khoản đó
// vừa tìm gần đây (không chia sẻ cache giữa các người bán khác nhau).
model FacebookKeywordSearch {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String

  keyword     String
  maxItems    Int
  resultCount Int
  newCount    Int

  searchedAt DateTime @default(now())

  @@index([userId, keyword, searchedAt])
}

enum CreditTransactionType {
  TOPUP // nạp tiền qua SePay
  SEARCH_CHARGE // trừ tiền do 1 lượt tìm nhóm Facebook gọi Apify thật
  ADJUSTMENT // superadmin tự cộng/trừ tay
}

// Sổ cái credit — mỗi thay đổi số dư (nạp/trừ/điều chỉnh tay) đều ghi 1 dòng ở đây kèm
// balanceAfter để đối soát sau này, không chỉ dựa vào User.creditBalance hiện tại.
model CreditTransaction {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String

  type         CreditTransactionType
  amount       Int // dương = cộng, âm = trừ (VNĐ)
  balanceAfter Int
  description  String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum TopUpRequestStatus {
  PENDING
  COMPLETED
  EXPIRED
}

// 1 lượt yêu cầu nạp tiền qua SePay — referenceCode nhúng vào nội dung chuyển khoản
// (hiện trong mã QR) để khớp với webhook SePay gửi về khi có giao dịch ngân hàng thật.
model TopUpRequest {
  id            String             @id @default(cuid())
  user          User               @relation(fields: [userId], references: [id])
  userId        String
  amount        Int // số tiền yêu cầu nạp, hiển thị lên QR
  referenceCode String             @unique
  status        TopUpRequestStatus @default(PENDING)

  creditedAmount     Int? // số tiền thực nhận từ SePay (có thể khác amount nếu chuyển dư/thiếu)
  sepayRawContent    String? // nội dung chuyển khoản thật từ webhook — giữ lại để đối soát khi có tranh chấp

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([referenceCode])
  @@index([userId, status])
}

// Banner trang chủ dạng slideshow (nhiều ảnh, tự chuyển) — singleton theo key cố định
// "home_banner", superadmin quản lý ở /admin/danh-muc. Trước đây lưu 1 URL duy nhất vào
// SiteContent (key "home_banner_image", nay bỏ, xem migration 20260828010000) — tách bảng
// riêng để có kiểu dữ liệu rõ ràng cho mảng ảnh + thời gian chuyển slide.
model HomeBannerConfig {
  key             String   @id
  images          String[] @default([])
  intervalSeconds Int      @default(5) // số giây giữa mỗi lần tự chuyển slide
  updatedAt       DateTime @updatedAt
}

// Cấu hình giá bán lại — singleton theo key, superadmin chỉnh ở /admin/danh-muc.
model PricingConfig {
  key            String   @id
  pricePerResult Int // VNĐ / kết quả trả về từ 1 lượt gọi Apify thật (tìm nhóm Facebook)
  minTopUpAmount Int? // VNĐ — giới hạn tối thiểu 1 lượt nạp credit; null = dùng mặc định DEFAULT_MIN_TOPUP_AMOUNT
  maxTopUpAmount Int? // VNĐ — giới hạn tối đa 1 lượt nạp credit; null = không giới hạn
  updatedAt      DateTime @updatedAt
}

// Báo xấu SĐT người nhận (bùng hàng, khó giao...) — do bất kỳ seller nào tự bấm ở form đơn
// hàng, tính CHUNG toàn sàn (không riêng theo từng seller) vì mục đích là cảnh báo chéo giữa
// các seller khác nhau về cùng 1 khách. unique theo (phone, reporterId) để 1 người không báo
// trùng nhiều lần đẩy tỉ lệ ảo — xem combinePhoneRisk (src/lib/orders.ts) cách gộp số lượt
// báo xấu này với tỉ lệ hoàn hàng GHN (etl/return-rate) thành 1 mức cảnh báo hiển thị.
model PhoneReport {
  id         String @id @default(cuid())
  phone      String
  reporter   User   @relation(fields: [reporterId], references: [id])
  reporterId String
  reason     String?

  createdAt DateTime @default(now())

  @@unique([phone, reporterId])
  @@index([phone])
}

// Bộ đếm rate-limit chống spam cho các hành động KHÔNG gắn với 1 user cụ thể (đăng ký,
// đăng nhập — chưa có/chưa xác thực được userId), khoá theo địa chỉ IP (và email với đăng
// nhập). key tự do, vd. "register:1.2.3.4" hay "login-email:a@b.com". Không có FK vì đây
// chỉ là bộ đếm tạm thời, không phải dữ liệu nghiệp vụ — hàng cũ có thể dọn định kỳ.
model RateLimitHit {
  key         String   @id
  windowStart DateTime @default(now())
  count       Int      @default(1)
}
